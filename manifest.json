{
  "manifest_version": 3,
  "name": "PlugKit Bilibili（B站管理）",
  "description": "B 站统一管理：PCDN/直播上传拦截、广告净化、播放增强、弹幕管理、账号工具与流量统计",
  "version": "0.2.4",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "externally_connectable": {
    "ids": [
      "*"
    ]
  },
  "permissions": [
    "declarativeNetRequest",
    "webRequest",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "*://*.bilibili.com/*",
    "*://*.bilivideo.cn/*",
    "*://*.bilivideo.com/*",
    "*://*.biliapi.net/*",
    "*://*.szbdyd.com/*",
    "*://*.onethingpcs.com/*",
    "*://*.yfcdn.net/*",
    "*://*.ppio.cloud/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "rules_base",
        "enabled": true,
        "path": "rules_base.json"
      },
      {
        "id": "rules_aggressive",
        "enabled": false,
        "path": "rules_aggressive.json"
      }
    ]
  },
  "action": {
    "default_title": "B站资源拦截",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "open_in_tab": false,
    "page": "options.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.bilibili.com/*"
      ],
      "run_at": "document_start",
      "js": [
        "content-scripts/content.js"
      ]
    },
    {
      "matches": [
        "*://*.bilibili.com/*"
      ],
      "run_at": "document_idle",
      "js": [
        "content-scripts/ui.js"
      ]
    }
  ],
  "plugkit": {
    "suite": "plugkit",
    "pluginId": "bilibili",
    "displayName": "B站管理",
    "category": "管理"
  }
}